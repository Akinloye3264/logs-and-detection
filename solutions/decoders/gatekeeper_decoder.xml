<!-- Exercise 1: gatekeeper authentication daemon (syslog) -->
<decoder name="gatekeeper">
  <program_name>^gatekeeper</program_name>
</decoder>

<decoder name="gatekeeper-auth">
  <parent>gatekeeper</parent>
  <regex type="pcre2">^(Accepted|Failed) (\w+) for user (\S+) from (\S+) port (\d+) method=(\w+)</regex>
  <order>login_result, auth_type, dstuser, srcip, srcport, auth_method</order>
</decoder>
