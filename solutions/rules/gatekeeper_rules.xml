<!-- Exercise 1 rules: IDs 100200-100204 -->
<group name="local,gatekeeper,authentication,">

  <rule id="100200" level="0">
    <decoded_as>gatekeeper</decoded_as>
    <description>gatekeeper: event received.</description>
  </rule>

  <rule id="100201" level="3">
    <if_sid>100200</if_sid>
    <field name="login_result">^Accepted$</field>
    <srcip>10.20.30.40</srcip>
    <description>gatekeeper: successful login from the trusted jump host.</description>
  </rule>

  <rule id="100202" level="8">
    <if_sid>100200</if_sid>
    <field name="login_result">^Accepted$</field>
    <srcip>!10.20.30.40</srcip>
    <description>gatekeeper: successful login from an untrusted IP address.</description>
  </rule>

  <rule id="100203" level="5">
    <if_sid>100200</if_sid>
    <field name="login_result">^Failed$</field>
    <description>gatekeeper: failed login attempt.</description>
  </rule>

  <rule id="100204" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100203</if_matched_sid>
    <same_source_ip />
    <description>gatekeeper: multiple failed logins from the same source (possible brute force).</description>
  </rule>

</group>
