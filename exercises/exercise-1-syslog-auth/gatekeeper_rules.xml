<group name="gatekeeper,authentication,">

  <rule id="100200" level="0">
    <decoded_as>gatekeeper</decoded_as>
    <description>Gatekeeper authentication event.</description>
  </rule>

  <rule id="100201" level="3">
    <if_sid>100200</if_sid>
    <field name="login_result">^Accepted$</field>
    <srcip>10.20.30.40</srcip>
    <description>Gatekeeper: successful login from trusted jump host.</description>
  </rule>

  <rule id="100202" level="8">
    <if_sid>100200</if_sid>
    <field name="login_result">^Accepted$</field>
    <srcip negate="yes">10.20.30.40</srcip>
    <description>Gatekeeper: successful login from an untrusted IP.</description>
  </rule>

  <rule id="100203" level="5">
    <if_sid>100200</if_sid>
    <field name="login_result">^Failed$</field>
    <description>Gatekeeper: failed login.</description>
  </rule>

  <rule id="100204" level="10" frequency="5" timeframe="120">
    <if_sid>100203</if_sid>
    <if_matched_sid>100203</if_matched_sid>
    <same_srcip />
    <description>Gatekeeper: repeated failed logins from the same IP.</description>
  </rule>

</group>
